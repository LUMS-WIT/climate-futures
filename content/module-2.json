{"version":3,"kind":"Article","sha256":"06df78d6695cee514c56068dce34492406da81462fc7a27156a4d9768a0f6906","slug":"module-2","location":"/modules/module-2.md","dependencies":[],"frontmatter":{"title":"Module 2: Scenarios & Integrated Assessment","content_includes_title":false,"github":"https://github.com/lums-wit/climate-futures","source_url":"https://github.com/lums-wit/climate-futures/blob/main/content-src/modules/module-2.md","edit_url":"https://github.com/lums-wit/climate-futures/edit/main/content-src/modules/module-2.md","exports":[{"format":"md","filename":"module-2.md","url":"/climate-futures/content/build/module-2-2cdca501dc457a80564ac31622a5c36b.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Weeks 4–6","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ruMW9Z7nc1"}],"key":"eYlraROstr"}],"key":"HVlRBstPCl"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This module covers the scenario-based tools used by researchers and governments to evaluate policy before implementation, including their methodological limitations.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"lhNJEKwKN1"}],"key":"YyQ7eXk6Cx"},{"type":"heading","depth":2,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Learning Objectives","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"Fj3C1EGfV2"}],"identifier":"learning-objectives","label":"Learning Objectives","html_id":"learning-objectives","implicit":true,"key":"tpvqM2RrWH"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":9,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Explain the function of an SSP narrative and the rationale for using scenario families rather than single forecasts.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Q66lHLNIiW"}],"key":"IoMvGx9mux"}],"key":"FWAX80K6F9"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Use an integrated assessment model to trace the outcome of a mitigation pathway.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"j8kDhM8Nin"}],"key":"JnyxFKSwg8"}],"key":"VWZQnF314r"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Connect carbon-pricing and fiscal mechanisms to national policy case studies.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"C8ImtH9kRb"}],"key":"yzz3mhhal4"}],"key":"bhZFNNWnax"}],"key":"b1nyC80ULY"},{"type":"heading","depth":2,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Guiding Question","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"JZ9RvSlDx0"}],"identifier":"guiding-question","label":"Guiding Question","html_id":"guiding-question","implicit":true,"key":"ZsGdlHSILp"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"A model’s output is only as reliable as its underlying assumptions — which assumptions in these models warrant the greatest scrutiny?","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"YasRN7g4kg"}],"key":"AaoahOmP2B"},{"type":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Lectures","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"GPsSjWEIht"}],"identifier":"lectures","label":"Lectures","html_id":"lectures","implicit":true,"key":"KF4CaCUOho"},{"type":"heading","depth":3,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Lecture 6: Introduction to IPCC and Scenarios","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"YHFWBBDvwA"}],"label":"lec6","identifier":"lec6","html_id":"lec6","key":"FdhoFQS5jg"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"An overview of the IPCC and the international climate negotiation process, the SSP and RCP scenario families used to project the future, and how integrated assessment models link climate, energy, water, and land to connect global scenarios with Pakistan-specific policy frameworks such as NDCs and the Enhanced Transparency Framework.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"sXAjdzoiHS"}],"key":"JioUiqDP04"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"yUM7QXEA8C"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec6","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec6","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"cEoj9gr2LB"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec6","key":"DVHQ8bFDCd"}],"key":"Bw0Ve6xFwa"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-06-introduction-to-ipcc-and-scenarios.pdf","width":"100%","key":"U4DPx7eqlO"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-06-introduct-aea7a8a534af3299eb3a2865bbf7fc4b.pdf","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"gUolvTJqvo"}],"urlSource":"/slides/lecture-06-introduction-to-ipcc-and-scenarios.pdf","static":true,"protocol":"file","key":"Eh6qZmq6Cd"}],"key":"Yt3kl6gxqK"},{"type":"heading","depth":3,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Lecture 7: Representative Concentration Pathways (RCPs)","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"i8IaP9vHOE"}],"label":"lec7","identifier":"lec7","html_id":"lec7","key":"x2MVnLlY2J"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"The history of IPCC emissions scenarios and the parallel process behind the newer scenario framework, the definition of a scenario as a conditional description of a possible future rather than a forecast, and the four Representative Concentration Pathways (RCP2.6, RCP4.5, RCP6.0, RCP8.5) with the integrated assessment models used to develop them. Includes an in-class activity using the IIASA RCP Database.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"Y5nXOGG1bP"}],"key":"RSozyQTQpw"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"JsNpxVmJU2"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec7","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec7","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"YGBYrFc2by"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec7","key":"qitMP49nMm"}],"key":"NKOoXzUpHR"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-07-representative-concentration-pathways.pdf","width":"100%","key":"XR83m0LK6s"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-07-represent-4559aa79cfae4361851913495a7d5511.pdf","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"Gu68MhRMWz"}],"urlSource":"/slides/lecture-07-representative-concentration-pathways.pdf","static":true,"protocol":"file","key":"DnLv3Pfu5w"}],"key":"uwfPcLJVf3"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Lecture 8: Shared Socioeconomic Pathways (SSPs)","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"DC2r5mli32"}],"label":"lec8","identifier":"lec8","html_id":"lec8","key":"IcgYr6lQ0I"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The five Shared Socioeconomic Pathways (SSP1 Sustainability, SSP2 Middle of the Road, SSP3 Regional Rivalry, SSP4 Inequality, SSP5 Fossil-fueled Development), their qualitative narratives and quantitative drivers such as population, GDP, and urbanization, and the reference scenarios produced by six integrated assessment modelling teams. The lecture then covers the SSP-RCP scenario matrix used in CMIP6 and closes with guidance on how a planner should select a scenario for long-lived infrastructure. Includes an in-class activity in which students match short narratives to SSP-RCP combinations.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"yj2vT9qHOJ"}],"key":"nGsMBxsxFe"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"ClboJSXVXj"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec8","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec8","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"Ei4f7Bq4Ud"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec8","key":"NT6MdqWHUX"}],"key":"svcGfNhX60"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-08-shared-socioeconomic-pathways.pdf","width":"100%","key":"bFaXca8hyz"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-08-shared-so-c78bdfe5c2bc9c3db6559e6939ddcdb1.pdf","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"pxFU43Jjcr"}],"urlSource":"/slides/lecture-08-shared-socioeconomic-pathways.pdf","static":true,"protocol":"file","key":"aJyPLDDNC8"}],"key":"i5fgtVnSSj"},{"type":"heading","depth":3,"position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Lecture 9: Introduction to Integrated Assessment Models (IAMs)","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"qBKHIqi1vA"}],"label":"lec9","identifier":"lec9","html_id":"lec9","key":"V2mhV0SEM3"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"The definition of integrated assessment and the two main families of integrated assessment models: highly aggregated cost-benefit models such as DICE, which are used to estimate the social cost of carbon, and detailed process-based models of the coupled human and Earth system. The lecture reviews the critique of aggregated models by Pindyck and the defence of the field by Weyant, compares process engineering, partial equilibrium, and general equilibrium approaches, and summarizes the strengths and limitations of these models. The second part introduces open and reproducible scientific programming, including the FAIR data principles and version control, as preparation for the modelling exercises in this course.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"bCSzpVroxx"}],"key":"ztkLfxqVoA"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"ddP7wGyc5r"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec9","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec9","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"DsQ0hB1hY1"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec9","key":"i34cGgQ4hu"}],"key":"DpVAfIzwFY"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-09-introduction-to-integrated-assessment-models.pdf","width":"100%","key":"ym7OiBGNTn"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-09-introduct-b652452ebdc9029659bb176ddc85f22f.pdf","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"TnaYxhmD80"}],"urlSource":"/slides/lecture-09-introduction-to-integrated-assessment-models.pdf","static":true,"protocol":"file","key":"BHTfmqvV6j"}],"key":"EeDTuElByL"},{"type":"heading","depth":3,"position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"children":[{"type":"text","value":"Lecture 10: Energy System Transitions","position":{"start":{"line":64,"column":1},"end":{"line":64,"column":1}},"key":"sk6w4PHlpr"}],"label":"lec10","identifier":"lec10","html_id":"lec10","key":"thRwveaP1S"},{"type":"paragraph","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"children":[{"type":"text","value":"The central role of the energy system in integrated assessment models and in global greenhouse gas emissions. The lecture covers the chain from primary to secondary to final energy, the methods used to account for primary energy from non-fossil sources, and refreshers on energy units, the Paris Agreement targets, and emitting, low-carbon, and negative-emission technologies. It then examines what IPCC AR6 mitigation scenarios imply for the energy system, including the scale-up of low-carbon supply, the electrification of end uses, shifts in investment, and the risk of stranded fossil assets.","position":{"start":{"line":66,"column":1},"end":{"line":66,"column":1}},"key":"uEYSVRnUWl"}],"key":"KJh0C5nmzu"},{"type":"paragraph","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"rAaNmMlRfp"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec10","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec10","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"guTvwZQxEy"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec10","key":"a45JVeL5Wp"}],"key":"yhKZ3MKeuX"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-10-energy-system-transitions.pdf","width":"100%","key":"QT4a3bUr5v"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-10-energy-sy-35196a7fe66b718f68f6c67a9069a29e.pdf","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"XxgYD4byrE"}],"urlSource":"/slides/lecture-10-energy-system-transitions.pdf","static":true,"protocol":"file","key":"IEdgqFZuX9"}],"key":"W6FjzZfGLA"},{"type":"paragraph","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"children":[{"type":"text","value":"More lecture slides for this module will be posted here as it is taught.","position":{"start":{"line":74,"column":1},"end":{"line":74,"column":1}},"key":"Yc7IcWdAto"}],"key":"HMb8cyp4rW"}],"key":"I8nF0v5LKk"}],"key":"VJpnFYIAcN"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Module 1: Climate Science Foundations","url":"/module-1","group":"Content — Climate Change Governance"},"next":{"title":"Module 3: Policy Landscape","url":"/module-3","group":"Content — Climate Change Governance"}}},"domain":"http://localhost:3000"}