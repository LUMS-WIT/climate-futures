":"heading","depth":2,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Lectures","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"bmaY5GKvtt"}],"identifier":"lectures","label":"Lectures","html_id":"lectures","implicit":true,"key":"wux2tJN0VI"},{"type":"heading","depth":3,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Lecture 6: Introduction to IPCC and Scenarios","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"pkYSJv0bXO"}],"label":"lec6","identifier":"lec6","html_id":"lec6","key":"K3OJSYm26c"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"An overview of the IPCC and the international climate negotiation process, the SSP and RCP scenario families used to project the future, and how integrated assessment models link climate, energy, water, and land to connect global scenarios with Pakistan-specific policy frameworks such as NDCs and the Enhanced Transparency Framework.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"jdfCItZDX4"}],"key":"Sb9f1iRhvJ"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"C82H2G4grb"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec6","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec6","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"YtC7l5qQNn"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec6","key":"fumdxbBRMn"}],"key":"WhbGrGPQxG"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-06-introduction-to-ipcc-and-scenarios.pdf","width":"100%","key":"UgPhYbavUa"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-06-introduct-7ec55c6143b7d761e6d199fb427a46c5.pdf","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"DAH6tdnToM"}],"urlSource":"/slides/lecture-06-introduction-to-ipcc-and-scenarios.pdf","static":true,"protocol":"file","key":"DrrjgDA8KV"}],"key":"NCzgOjYcY6"},{"type":"heading","depth":3,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"text","value":"Lecture 7: Representative Concentration Pathways (RCPs)","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"b6uEMO9U4k"}],"label":"lec7","identifier":"lec7","html_id":"lec7","key":"WErw6kzy9j"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"The history of IPCC emissions scenarios and the parallel process behind the newer scenario framework, the definition of a scenario as a conditional description of a possible future rather than a forecast, and the four Representative Concentration Pathways (RCP2.6, RCP4.5, RCP6.0, RCP8.5) with the integrated assessment models used to develop them. Includes an in-class activity using the IIASA RCP Database.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"CtANrxhpH3"}],"key":"sKpWFTwvNd"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"Mm3qZNmCCb"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec7","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec7","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"j7n0QGUXAC"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec7","key":"plyHTPR8MD"}],"key":"KQThw51q3a"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-07-representative-concentration-pathways.pdf","width":"100%","key":"BwhCgba2d1"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-07-represent-31842cd8800951877cf047ddd09d1cb2.pdf","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"QRTxbANz8H"}],"urlSource":"/slides/lecture-07-representative-concentration-pathways.pdf","static":true,"protocol":"file","key":"tmeIkmmRhm"}],"key":"EOo5ODfxHw"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"In-class activity: ","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"PTc9a3uO3D"},{"type":"link","url":"/climate-futures/content/build/lecture-07-activity--b77c1268517aad8fd8aa85b7a94846d1.pdf","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Exploring the RCP Database (PDF)","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"ujVPJPiZe2"}],"urlSource":"/activities/lecture-07-activity-rcp-database.pdf","static":true,"protocol":"file","key":"MbYqPM9mIp"}],"key":"g8PPBIYRu1"},{"type":"heading","depth":3,"position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"Lecture 8: Shared Socioeconomic Pathways (SSPs)","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"TzjtjASn0k"}],"label":"lec8","identifier":"lec8","html_id":"lec8","key":"dTQLUgjeGG"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"The five Shared Socioeconomic Pathways (SSP1 Sustainability, SSP2 Middle of the Road, SSP3 Regional Rivalry, SSP4 Inequality, SSP5 Fossil-fueled Development), their qualitative narratives and quantitative drivers such as population, GDP, and urbanization, and the reference scenarios produced by six integrated assessment modelling teams. The lecture then covers the SSP-RCP scenario matrix used in CMIP6 and closes with guidance on how a planner should select a scenario for long-lived infrastructure. Includes an in-class activity in which students match short narratives to SSP-RCP combinations.","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"nu4BNHLlEM"}],"key":"CJmtP3P38M"},{"type":"paragraph","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"Bva2bUriti"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec8","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec8","position":{"start":{"line":48,"column":1},"end":{"line":48,"column":1}},"key":"kx23DCemhq"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec8","key":"zIndznyU3l"}],"key":"vkgxOxv8R2"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-08-shared-socioeconomic-pathways.pdf","width":"100%","key":"AElREA3Y7t"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-08-shared-so-c973742606de0bb8d04e553554bb7cf0.pdf","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"key":"SwpaTwdz3A"}],"urlSource":"/slides/lecture-08-shared-socioeconomic-pathways.pdf","static":true,"protocol":"file","key":"YvCjoNH3q8"}],"key":"Ixt6JZ8SSu"},{"type":"heading","depth":3,"position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"text","value":"Lecture 9: Introduction to Integrated Assessment Models (IAMs)","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"qE9EqaH8oi"}],"label":"lec9","identifier":"lec9","html_id":"lec9","key":"kJBkYRuVww"},{"type":"paragraph","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"The definition of integrated assessment and the two main families of integrated assessment models: highly aggregated cost-benefit models such as DICE, which are used to estimate the social cost of carbon, and detailed process-based models of the coupled human and Earth system. The lecture reviews the critique of aggregated models by Pindyck and the defence of the field by Weyant, compares process engineering, partial equilibrium, and general equilibrium approaches, and summarizes the strengths and limitations of these models. The second part introduces open and reproducible scientific programming, including the FAIR data principles and version control, as preparation for the modelling exercises in this course.","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"CTvFESFzja"}],"key":"ga2yyON2HW"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"AUy7ydRb7Y"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec9","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec9","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"k7eHFF4Rix"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec9","key":"YdhFo4KlO9"}],"key":"jV1SDiqjZs"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-09-introduction-to-integrated-assessment-models.pdf","width":"100%","key":"XozXyvDUpS"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-09-introduct-ad32b431ccdb79f266cd83af0283c9de.pdf","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"Lepitkd6uO"}],"urlSource":"/slides/lecture-09-introduction-to-integrated-assessment-models.pdf","static":true,"protocol":"file","key":"ovzA1VgbVk"}],"key":"a7xloq2Fbn"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"In-class activity: ","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"vr790dE2zZ"},{"type":"link","url":"/climate-futures/content/build/lecture-09-activity--899d35f6fd39aa5e245eea09dc6e8d21.pdf","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"The Social Cost of Carbon (PDF)","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"FBlNLkOeMj"}],"urlSource":"/activities/lecture-09-activity-cost-of-carbon.pdf","static":true,"protocol":"file","key":"CFILS0VruT"}],"key":"ki08YvVnZO"},{"type":"heading","depth":3,"position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"children":[{"type":"text","value":"Lecture 10: Energy System Transitions","position":{"start":{"line":68,"column":1},"end":{"line":68,"column":1}},"key":"LFww8agPmf"}],"label":"lec10","identifier":"lec10","html_id":"lec10","key":"osBLQeRImD"},{"type":"paragraph","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"children":[{"type":"text","value":"The central role of the energy system in integrated assessment models and in global greenhouse gas emissions. The lecture covers the chain from primary to secondary to final energy, the methods used to account for primary energy from non-fossil sources, and refreshers on energy units, the Paris Agreement targets, and emitting, low-carbon, and negative-emission technologies. It then examines what IPCC AR6 mitigation scenarios imply for the energy system, including the scale-up of low-carbon supply, the electrification of end uses, shifts in investment, and the risk of stranded fossil assets.","position":{"start":{"line":70,"column":1},"end":{"line":70,"column":1}},"key":"Af8UTzWrYv"}],"key":"jXErI1PGAu"},{"type":"paragraph","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"tHdnH0VaR6"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec10","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec10","position":{"start":{"line":72,"column":1},"end":{"line":72,"column":1}},"key":"EDA0QamD5W"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec10","key":"PP4fehLIbm"}],"key":"ltQ1mBJnxa"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-10-energy-system-transitions.pdf","width":"100%","key":"UtCyuXCnQe"},{"type":"paragraph","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-10-energy-sy-606d228962714b62ae15b52f6c3cb918.pdf","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":76,"column":1},"end":{"line":76,"column":1}},"key":"lf0nTigJ76"}],"urlSource":"/slides/lecture-10-energy-system-transitions.pdf","static":true,"protocol":"file","key":"KbIu9QUqT6"}],"key":"ezeMHSBcoc"},{"type":"paragraph","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"In-class activity: ","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"TUX3GWOkaI"},{"type":"link","url":"/climate-futures/content/build/lecture-10-activity--b833415cefe2637a004949872ecf6049.pdf","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"children":[{"type":"text","value":"Electrification in the AR6 Scenario Database (PDF)","position":{"start":{"line":78,"column":1},"end":{"line":78,"column":1}},"key":"QVl4tdscOq"}],"urlSource":"/activities/lecture-10-activity-ar6-scenario-database.pdf","static":true,"protocol":"file","key":"dfmwSvpDBb"}],"key":"cXiub5Yt8u"},{"type":"heading","depth":3,"position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"Lecture 11: Introduction to MESSAGEix","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"qFFD7BxfN6"}],"label":"lec11","identifier":"lec11","html_id":"lec11","key":"u7nqYd18w6"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"The role of least-cost optimisation in process-based integrated assessment models, introduced through linear programming: decision variables, an objective function, and constraints, worked through a small power system with coal and wind. The lecture then presents MESSAGEix as a systems optimisation model that minimises the total discounted cost of an energy system, distinguishes capacity from activity, and describes how the model represents systems in transition. It closes with the open-source MESSAGEix and ixmp framework, its documentation and installation, and the scenario workflow used in the coding exercises for this course.","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"RNCXY3gMdO"}],"key":"GfTFv9gpli"},{"type":"paragraph","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"hBlnWwSiMg"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec11","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec11","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"CdkQmsd4J9"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec11","key":"cnI5s0110a"}],"key":"pW5QVkW7yx"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-11-introduction-to-messageix.pdf","width":"100%","key":"NKOC5i45Ot"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-11-introduct-99caf9aa76d9f75dbd2ed907d5cfc51e.pdf","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"iVsXm2yI7x"}],"urlSource":"/slides/lecture-11-introduc