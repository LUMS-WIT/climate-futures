thub.io/climate-futures/content/module-2/#lec7","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec7","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"XJ5GjO13vN"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec7","key":"JlHbPgsZoa"}],"key":"iZ0SFiOWhw"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-07-representative-concentration-pathways.pdf","width":"100%","key":"AL7RsJ90Nn"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-07-represent-0f75aa3668b54374e319ad319e9ec6c3.pdf","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"sqogDQicrQ"}],"urlSource":"/slides/lecture-07-representative-concentration-pathways.pdf","static":true,"protocol":"file","key":"Y4VQR2nXEQ"}],"key":"jbI4PFNjDm"},{"type":"heading","depth":3,"position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"Lecture 8: Shared Socioeconomic Pathways (SSPs)","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"xT3HwhdWHn"}],"label":"lec8","identifier":"lec8","html_id":"lec8","key":"Mr4hxSQgGL"},{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"children":[{"type":"text","value":"The five Shared Socioeconomic Pathways (SSP1 Sustainability, SSP2 Middle of the Road, SSP3 Regional Rivalry, SSP4 Inequality, SSP5 Fossil-fueled Development), their qualitative narratives and quantitative drivers such as population, GDP, and urbanization, and the reference scenarios produced by six integrated assessment modelling teams. The lecture then covers the SSP-RCP scenario matrix used in CMIP6 and closes with guidance on how a planner should select a scenario for long-lived infrastructure. Includes an in-class activity in which students match short narratives to SSP-RCP combinations.","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"gEFK0KnmKO"}],"key":"KriUmbs1Va"},{"type":"paragraph","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"Permalink: ","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"n7chrKpQ2f"},{"type":"link","url":"https://lums-wit.github.io/climate-futures/content/module-2/#lec8","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"children":[{"type":"text","value":"​/content​/module​-2​/​#lec8","position":{"start":{"line":46,"column":1},"end":{"line":46,"column":1}},"key":"enPIhdKc7b"}],"urlSource":"https://lums-wit.github.io/climate-futures/content/module-2/#lec8","key":"dCtHD3i8RQ"}],"key":"Y7msApVqlj"},{"type":"iframe","style":{"border":"1px solid #e0e0e0"},"src":"/climate-futures/content/slides/lecture-08-shared-socioeconomic-pathways.pdf","width":"100%","key":"mBPY7PcQml"},{"type":"paragraph","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"link","url":"/climate-futures/content/build/lecture-08-shared-so-013f7860367b5b9b1ef46775adeb93a3.pdf","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Download slides (PDF)","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"ai6QROIxvS"}],"urlSource":"/slides/lecture-08-shared-socioeconomic-pathways.pdf","static":true,"protocol":"file","key":"impmlOZxjC"}],"key":"noy1D6hX8p"},{"type":"paragraph","position":{"start":{"line":52,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"More lecture slides for this module will be posted here as it 